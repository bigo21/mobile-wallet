{
	"name": "mobilewallet-site",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.27.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bootstrap": "^5.2.11",
		"@types/node": "^26.6.5",
		"sass-embedded": "^1.105.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@tabler/icons-webfont": "^3.35.0",
		"bootstrap": "^5.3.8",
		"country-flag-icons": "^1.6.20",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"libphonenumber-js": "^1.13.15",
		"postgres": "^3.4.9",
		"resend": "^6.33.0",
		"swiper": "^12.0.3",
		"ukiyojs": "^4.2.0",
		"valibot": "^1.5.0"
	}
}
