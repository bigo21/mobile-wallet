# Variables d'environnement — copier dans .env.local (dev) et dans Vercel (prod).

# --- Supabase (base des leads) ---
# Connection string "Transaction pooler" (port 6543).
# ⚠️ Encoder les caractères spéciaux du mot de passe (: -> %3A, $ -> %24, @ -> %40, etc.).
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Resend (envoi d'emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Emails ---
NOTIFICATION_EMAIL=yvan.tadie@mobilewalletinc.com
MAIL_FROM_EMAIL=contact@mobilewalletinc.com
MAIL_FROM_NAME=MobileWallet Vitrine

