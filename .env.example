# Resend (https://resend.com) — used by the contact form and the presentation request
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — these are the defaults
# The sender; its domain (mobilewalletinc.com) must be verified in Resend
RESEND_FROM="MobileWallet <support@mobilewalletinc.com>"
# Public address of the site — used for links and the logo inside emails
SITE_URL=https://mobilewalletinc.com
# Where enquiries and presentation leads are delivered
CONTACT_TO=support@mobilewalletinc.com

# Supabase Postgres — transaction pooler (port 6543), password URL-encoded.
# Leads are saved in the private "mobilewallet" schema (see supabase/migrations/).
# Without it the forms still work, leads just aren't saved.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Name and password of the /admin leads page — the page stays locked until both are set
ADMIN_NAME=
ADMIN_PASSWORD=
